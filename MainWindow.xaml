<Window x:Class="WireShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WireShift"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[window_title], Mode=OneWay}"
        Width="900" Height="600" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Папка -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[folder_placeholder], Mode=OneWay}"
                     ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[folder_tooltip], Mode=OneWay}"/>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[pick_folder], Mode=OneWay}"
                    Click="PickFolder_Click"/>
            <CheckBox Grid.Column="2" x:Name="RecursiveBox"
                      Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[include_subfolders], Mode=OneWay}"
                      IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="Rescan_Click" Unchecked="Rescan_Click"/>
        </Grid>

        <!-- Новый адрес -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[new_host_label], Mode=OneWay}"/>
            <TextBox Grid.Column="1" x:Name="NewHostBox" Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     TextChanged="NewHostBox_TextChanged"
                     ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[new_host_tooltip], Mode=OneWay}"/>
            <TextBlock Grid.Column="2" x:Name="ValidationText" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="#B00020"/>
        </Grid>

        <!-- Таблица конфигов -->
        <DataGrid Grid.Row="2" x:Name="ConfigsGrid" AutoGenerateColumns="False"
                  IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  AlternatingRowBackground="#F5F7FA" BorderThickness="1" BorderBrush="#DDD">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="40"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[col_file], Mode=OneWay}"
                                    Binding="{Binding RelativePath}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[col_current_host], Mode=OneWay}"
                                    Binding="{Binding CurrentHost}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[col_port], Mode=OneWay}"
                                    Binding="{Binding Port}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[col_preview], Mode=OneWay}"
                                    Binding="{Binding Preview}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[col_status], Mode=OneWay}"
                                    Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Действия -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[select_all], Mode=OneWay}"
                    Click="SelectAll_Click"/>
            <Button Grid.Column="1" Margin="6,0,0,0"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[select_none], Mode=OneWay}"
                    Click="SelectNone_Click"/>
            <Button Grid.Column="3" x:Name="ApplyButton"
                    Style="{StaticResource ActionButton}"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[apply], Mode=OneWay}"
                    FontWeight="SemiBold" IsEnabled="False"
                    Click="Apply_Click"/>
        </Grid>

        <!-- Статус-бар + язык -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="8,4"
                Background="#F0F2F5" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="LangBox" Width="110" Margin="12,0,0,0"
                          SelectionChanged="LangBox_SelectionChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>
