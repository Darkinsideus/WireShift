<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WireShift</RootNamespace>
    <AssemblyName>WireShift</AssemblyName>
    <ApplicationIcon>wireshift.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>WireShift</Product>
    <Description>Массовая замена Endpoint в WireGuard-конфигах</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
